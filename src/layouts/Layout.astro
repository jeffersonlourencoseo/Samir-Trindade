---
import SEO from '../components/SEO.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />
    <SchemaLocalBusiness />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <slot name="head" />
    <style is:global>
      html, body {
        overflow-x: hidden;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        letter-spacing: -0.02em;
      }
      /* Estilização global de artigos */
      .prose-article h1 {
        display: none;
      }
      .prose-article h2 {
        font-size: 1.875rem;
        font-weight: 600;
        color: #1c1917;
        margin-top: 3rem;
        margin-bottom: 1.25rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-family: 'Playfair Display', serif;
      }
      .prose-article h3 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #292524;
        margin-top: 2rem;
        margin-bottom: 1rem;
        line-height: 1.3;
        font-family: 'Playfair Display', serif;
      }
      .prose-article p {
        margin-bottom: 1.25rem;
        line-height: 1.8;
        color: #44403c;
      }
      .prose-article ul,
      .prose-article ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
      }
      .prose-article li {
        margin-bottom: 0.5rem;
        line-height: 1.7;
      }
      .prose-article a[href*="wa.me"] {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background-color: #059669;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 0.9375rem;
        padding: 0.75rem 1.75rem;
        border-radius: 9999px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.25);
        margin: 1rem 0;
        font-family: 'DM Sans', sans-serif;
      }
      .prose-article a[href*="wa.me"]:hover {
        background-color: #b45309;
        color: #ffffff !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(180, 83, 9, 0.25);
      }
      .prose-article hr {
        border: 0;
        height: 1px;
        background: #e7e5e4;
        margin: 2.5rem 0;
      }
      .prose-article strong {
        color: #1c1917;
        font-weight: 700;
      }
      .prose-article blockquote {
        border-left: 3px solid #b45309;
        padding-left: 1.25rem;
        margin: 1.5rem 0;
        font-style: italic;
        color: #57534e;
        font-family: 'Playfair Display', serif;
      }
      .prose-article table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
      }
      .prose-article th,
      .prose-article td {
        border: 1px solid #e7e5e4;
        padding: 0.75rem 1rem;
        text-align: left;
      }
      .prose-article th {
        background: #fafaf9;
        font-weight: 700;
        color: #1c1917;
      }
      .prose-article tr:nth-child(even) {
        background: #fafaf9;
      }
      .prose-article img {
        max-width: 100%;
        height: auto;
        border-radius: 0.5rem;
        margin: 1.5rem 0;
      }
      .prose-article code {
        font-size: 0.875rem;
        background: #f5f5f4;
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        color: #1c1917;
      }
      .prose-article pre {
        background: #1c1917;
        color: #fafaf9;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 1.5rem 0;
      }
      .prose-article pre code {
        background: transparent;
        color: inherit;
        padding: 0;
      }
    </style>
  </head>
  <body class="font-sans text-charcoal antialiased bg-cream">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppBtn />
    <script src="/scripts/menu.js" defer></script>
  </body>
</html>
