---
import SEO from '../components/SEO.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />
    <SchemaLocalBusiness />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style is:global>
      /* Estilização global de artigos */
      .prose-article h1 {
        display: none;
      }
      .prose-article h2 {
        font-size: 1.75rem;
        font-weight: 800;
        color: #111827;
        margin-top: 3rem;
        margin-bottom: 1.25rem;
        line-height: 1.2;
        letter-spacing: -0.025em;
      }
      .prose-article h3 {
        font-size: 1.375rem;
        font-weight: 700;
        color: #1f2937;
        margin-top: 2rem;
        margin-bottom: 1rem;
        line-height: 1.3;
      }
      .prose-article p {
        margin-bottom: 1.25rem;
        line-height: 1.75;
        color: #374151;
      }
      .prose-article ul,
      .prose-article ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
      }
      .prose-article li {
        margin-bottom: 0.5rem;
        line-height: 1.7;
      }
      .prose-article a[href*="wa.me"] {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background-color: #1E3A8A;
        color: #ffffff !important;
        font-weight: 700;
        font-size: 0.9375rem;
        padding: 0.75rem 1.5rem;
        border-radius: 9999px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 14px rgba(30, 58, 138, 0.25);
        margin: 1rem 0;
      }
      .prose-article a[href*="wa.me"]:hover {
        background-color: #FACC15;
        color: #000000 !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(250, 204, 21, 0.3);
      }
      .prose-article hr {
        border: 0;
        height: 1px;
        background: #e5e7eb;
        margin: 2.5rem 0;
      }
      .prose-article strong {
        color: #111827;
        font-weight: 700;
      }
      .prose-article blockquote {
        border-left: 4px solid #FACC15;
        padding-left: 1.25rem;
        margin: 1.5rem 0;
        font-style: italic;
        color: #4b5563;
      }
      .prose-article table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
      }
      .prose-article th,
      .prose-article td {
        border: 1px solid #e5e7eb;
        padding: 0.75rem 1rem;
        text-align: left;
      }
      .prose-article th {
        background: #f9fafb;
        font-weight: 700;
        color: #111827;
      }
      .prose-article tr:nth-child(even) {
        background: #f9fafb;
      }
    </style>
  </head>
  <body class="font-sans text-gray-900 antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppBtn />
  </body>
</html>
