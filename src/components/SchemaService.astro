---
interface Props {
  name: string;
  description: string;
  providerId?: string;
  areaServed?: string;
  url: string;
  image?: string;
}

const {
  name,
  description,
  providerId = '#local-business',
  areaServed = 'Rio de Janeiro',
  url,
  image,
} = Astro.props;

const schema: any = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name,
  description,
  provider: {
    '@id': providerId,
  },
  areaServed: {
    '@type': 'City',
    name: areaServed,
  },
  url,
};

if (image) {
  schema.image = image;
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
