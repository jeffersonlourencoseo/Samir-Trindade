---
import { SITE_CONFIG } from '../data/config';

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/servicos', label: 'Planos' },
  { href: '/blog', label: 'Blog' },
  { href: '/contato', label: 'Contato' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full border-b border-white/10 bg-accent/95 backdrop-blur-md transition-all duration-300"
>
  <div class="container mx-auto flex h-20 items-center justify-between px-6 md:px-12">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 transition-transform duration-300 hover:scale-105">
      <span class="text-xl font-black tracking-tighter text-primary">
        SAMIR <span class="text-white">TRINDADE</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="relative text-sm font-medium text-gray-300 transition-all duration-300 hover:text-white"
        >
          {link.label}
        </a>
      ))}
      <a
        href={SITE_CONFIG.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-primary px-6 py-2.5 text-sm font-bold text-accent transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-primary/20 active:scale-95"
      >
        WhatsApp
      </a>
    </nav>

    <!-- Mobile Toggle -->
    <button
      id="menu-toggle"
      class="relative z-[1000] flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
    >
      <span class="menu-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="menu-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="menu-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-[999] flex translate-x-full flex-col items-center justify-center bg-accent transition-transform duration-500 md:hidden"
  >
    <nav class="flex flex-col items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-link text-3xl font-black tracking-tighter text-white transition-all duration-300 hover:text-primary"
        >
          {link.label}
        </a>
      ))}
      <a
        href={SITE_CONFIG.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 rounded-full bg-primary px-10 py-4 text-lg font-bold text-accent shadow-xl transition-all duration-300 hover:scale-105 active:scale-95"
      >
        Falar no WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const drawer = document.getElementById('mobile-menu');
  const links = drawer.querySelectorAll('.mobile-link');
  const lines = toggle.querySelectorAll('.menu-line');
  let open = false;

  function setOpen(state) {
    open = state;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) {
      drawer.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
      lines[0].classList.add('translate-y-2', 'rotate-45');
      lines[1].classList.add('opacity-0');
      lines[2].classList.add('-translate-y-2', '-rotate-45');
    } else {
      drawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
      lines[0].classList.remove('translate-y-2', 'rotate-45');
      lines[1].classList.remove('opacity-0');
      lines[2].classList.remove('-translate-y-2', '-rotate-45');
    }
  }

  toggle.addEventListener('click', () => setOpen(!open));
  links.forEach((l) => l.addEventListener('click', () => setOpen(false)));
  drawer.addEventListener('click', (e) => {
    if (e.target === drawer) setOpen(false);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && open) setOpen(false);
  });
</script>
