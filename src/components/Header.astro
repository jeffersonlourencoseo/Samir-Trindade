---
import { SITE_CONFIG } from '../data/config';

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/servicos', label: 'Planos' },
  { href: '/blog', label: 'Blog' },
  { href: '/contato', label: 'Contato' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full border-b border-white/10 bg-secondary/95 backdrop-blur-md transition-all duration-300"
>
  <div class="container mx-auto flex h-20 items-center justify-between px-6 md:px-12">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 transition-transform duration-300 hover:scale-105">
      <span class="font-display text-xl font-semibold tracking-tight text-white">
        Samir <span class="text-accent">Trindade</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="relative text-sm font-medium text-stone-300 transition-all duration-300 hover:text-white"
        >
          {link.label}
        </a>
      ))}
      <a
        href={SITE_CONFIG.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-accent px-6 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:scale-105 hover:shadow-gold active:scale-95"
      >
        WhatsApp
      </a>
    </nav>

    <!-- Mobile Toggle -->
    <button
      id="menu-toggle"
      class="relative z-[1001] flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
    >
      <span class="menu-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="menu-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="menu-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
    </button>
  </div>
</header>

<!-- Mobile Drawer -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[1000] flex translate-x-full flex-col items-center justify-center bg-secondary transition-transform duration-500 md:hidden"
>
  <nav class="flex flex-col items-center gap-8 px-6">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-link font-display text-3xl font-semibold tracking-tight text-white transition-all duration-300 hover:text-accent"
      >
        {link.label}
      </a>
    ))}
    <a
      href={SITE_CONFIG.whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 rounded-full bg-accent px-10 py-4 text-lg font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 active:scale-95"
    >
      Falar no WhatsApp
    </a>
  </nav>
</div>
