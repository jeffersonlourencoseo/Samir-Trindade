---
import Layout from '../layouts/Layout.astro';
import SchemaBreadcrumb from '../components/SchemaBreadcrumb.astro';
import { SITE_CONFIG } from '../data/config';
---

<Layout title="Contato" description="Entre em contato com Samir Trindade, corretor de plano de saúde no Rio de Janeiro. Atendimento presencial e online. WhatsApp, telefone e formulário.">
  <SchemaBreadcrumb items={[{ name: 'Início', url: '/' }, { name: 'Contato', url: '/contato' }]} />
  <section class="bg-secondary py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl text-center">
        <span class="mb-4 inline-block text-sm font-bold uppercase tracking-widest text-primary">Contato</span>
        <h1 class="text-4xl font-extrabold leading-tight tracking-tighter text-white md:text-6xl mb-10">
          Vamos conversar sobre seu plano
        </h1>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="grid gap-12 lg:grid-cols-2">
        <!-- NAP + INFO -->
        <div class="space-y-10">
          <div class="rounded-2xl bg-gray-50 p-10 border border-gray-100">
            <h2 class="mb-6 text-2xl font-extrabold tracking-tighter text-gray-900">
              Informações de contato
            </h2>
            <address class="not-italic space-y-5">
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Endereço</p>
                <p class="text-gray-900">
                  {SITE_CONFIG.address.street}<br />
                  {SITE_CONFIG.address.neighborhood} — {SITE_CONFIG.address.city}/{SITE_CONFIG.address.state}
                  <br />
                  CEP {SITE_CONFIG.address.zip}
                </p>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Telefone / WhatsApp</p>
                <p class="text-gray-900">{SITE_CONFIG.phone}</p>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-gray-400">E-mail</p>
                <p class="text-gray-900">{SITE_CONFIG.email}</p>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Horário de atendimento</p>
                <p class="text-gray-900">{SITE_CONFIG.hours}</p>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Registro ANS</p>
                <p class="text-gray-900">{SITE_CONFIG.ansRegister}</p>
              </div>
            </address>
          </div>

          <div class="flex flex-col gap-4">
            <a
              href={SITE_CONFIG.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-8 py-5 text-lg font-bold text-white shadow-lg shadow-primary/20 transition-all duration-300 hover:scale-105 active:scale-95"
            >
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              Falar no WhatsApp
            </a>

            <a
              href={`tel:${SITE_CONFIG.phoneRaw}`}
              class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-gray-200 px-8 py-5 text-lg font-bold text-gray-900 transition-all duration-300 hover:scale-105 hover:border-primary active:scale-95"
            >
              Ligar Agora
            </a>
          </div>
        </div>

        <!-- FORMULÁRIO -->
        <div class="rounded-2xl bg-gray-50 p-10 border border-gray-100">
          <h2 class="mb-6 text-2xl font-extrabold tracking-tighter text-gray-900">
            Envie uma mensagem
          </h2>

          <form
            action="https://formspree.io/f/mnjrpowy"
            method="POST"
            class="space-y-6"
          >
            <div>
              <label for="nome" class="mb-2 block text-sm font-bold text-gray-700">Nome</label>
              <input
                type="text"
                id="nome"
                name="nome"
                required
                class="w-full rounded-xl border border-gray-200 bg-white px-5 py-4 text-gray-900 outline-none transition-all focus:border-secondary focus:ring-4 focus:ring-secondary/10"
                placeholder="Seu nome completo"
              />
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-bold text-gray-700">E-mail</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-xl border border-gray-200 bg-white px-5 py-4 text-gray-900 outline-none transition-all focus:border-secondary focus:ring-4 focus:ring-secondary/10"
                placeholder="seu@email.com"
              />
            </div>

            <div>
              <label for="telefone" class="mb-2 block text-sm font-bold text-gray-700">Telefone</label>
              <input
                type="tel"
                id="telefone"
                name="telefone"
                class="w-full rounded-xl border border-gray-200 bg-white px-5 py-4 text-gray-900 outline-none transition-all focus:border-secondary focus:ring-4 focus:ring-secondary/10"
                placeholder="(21) 99999-9999"
              />
            </div>

            <div>
              <label for="interesse" class="mb-2 block text-sm font-bold text-gray-700">Interesse</label>
              <select
                id="interesse"
                name="interesse"
                class="w-full rounded-xl border border-gray-200 bg-white px-5 py-4 text-gray-900 outline-none transition-all focus:border-secondary focus:ring-4 focus:ring-secondary/10"
              >
                <option value="">Selecione...</option>
                <option value="empresarial">Plano Empresarial</option>
                <option value="mei">Plano MEI</option>
                <option value="familiar">Plano Familiar/Individual</option>
                <option value="outro">Outro</option>
              </select>
            </div>

            <div>
              <label for="mensagem" class="mb-2 block text-sm font-bold text-gray-700">Mensagem</label>
              <textarea
                id="mensagem"
                name="mensagem"
                rows="5"
                required
                class="w-full rounded-xl border border-gray-200 bg-white px-5 py-4 text-gray-900 outline-none transition-all focus:border-secondary focus:ring-4 focus:ring-secondary/10"
                placeholder="Conte um pouco sobre o que você precisa..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full rounded-full bg-secondary px-8 py-5 text-lg font-bold text-white shadow-lg shadow-secondary/20 transition-all duration-300 hover:scale-105 active:scale-95"
            >
              Enviar mensagem
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
