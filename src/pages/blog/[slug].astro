---
import Layout from '../../layouts/Layout.astro';
import SchemaArticle from '../../components/SchemaArticle.astro';
import SchemaBreadcrumb from '../../components/SchemaBreadcrumb.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../../data/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const toc = headings.filter((h) => h.depth === 2);

const relatedPosts = (await getCollection('blog'))
  .filter((p) => p.slug !== post.slug && p.data.tags.some((t) => post.data.tags.includes(t)))
  .slice(0, 3);

const formattedDate = post.data.publishDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const updateDate = new Date().toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const canonicalUrl = new URL(Astro.url.pathname, SITE_CONFIG.domain).toString();

const breadcrumbItems = [
  { name: 'Blog', url: '/blog' },
  { name: post.data.title },
];
---

<Layout title={post.data.title} description={post.data.description} type="article">
  <SchemaArticle
    headline={post.data.title}
    description={post.data.description}
    image={post.data.image || ''}
    url={canonicalUrl}
    datePublished={post.data.publishDate.toISOString()}
    dateModified={post.data.publishDate.toISOString()}
  />
  <SchemaBreadcrumb items={[{ name: 'Início', url: '/' }, { name: 'Blog', url: '/blog' }, { name: post.data.title }]} />
  {post.data.faq && post.data.faq.length > 0 && (
    <SchemaFAQ questions={post.data.faq} />
  )}

  <!-- HERO -->
  <section class="bg-secondary py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-4xl">
        <Breadcrumbs items={breadcrumbItems} />
        <div class="flex flex-wrap gap-2 mb-6">
          {post.data.tags.map((tag) => (
            <span class="rounded-full bg-accent/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-accent border border-accent/20">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="font-display text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl lg:text-6xl mb-6">
          {post.data.title}
        </h1>
        <p class="text-stone-400 text-sm">
          Publicado em <time datetime={post.data.publishDate.toISOString()}>{formattedDate}</time>
          <span class="mx-2">·</span>
          Atualizado em <time datetime={new Date().toISOString()}>{updateDate}</time>
          <span class="mx-2">·</span>
          Por {SITE_CONFIG.author}
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-cream">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-16 lg:grid-cols-[1fr_340px]">
          <!-- Índice + Artigo -->
          <div class="order-2 lg:order-1">
            <!-- TOC -->
            {toc.length > 0 && (
              <div class="rounded-xl bg-white p-6 border border-stone-200 shadow-elegant mb-10">
                <h3 class="font-display mb-4 text-sm font-semibold uppercase tracking-wider text-charcoal">
                  Neste artigo
                </h3>
                <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                  {toc.map((h) => (
                    <a href={`#${h.slug}`} class="text-stone-500 hover:text-accent transition-colors">{h.text}</a>
                  ))}
                </nav>
              </div>
            )}

            <!-- Resumo para AI -->
            <div class="rounded-xl border-l-4 border-accent bg-accent/5 p-6 mb-10">
              <p class="text-stone-700 leading-relaxed">
                <strong class="text-charcoal">Resumo:</strong> {post.data.description}
              </p>
            </div>

            <article class="prose-article">
              <Content />
            </article>

            <!-- Author Bio -->
            <div class="mt-16 rounded-xl border border-stone-200 bg-white p-8 shadow-elegant">
              <div class="flex items-start gap-5">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-secondary font-display text-lg font-semibold text-white">S</div>
                <div>
                  <p class="font-display text-lg font-semibold text-charcoal">{SITE_CONFIG.author}</p>
                  <p class="text-sm text-stone-500 mt-1">
                    Corretor de planos de saúde credenciado ANS <strong class="text-charcoal">{SITE_CONFIG.ansRegister}</strong>, com escritório no Centro do Rio de Janeiro. Atende empresas de 2 a 3.000 vidas, MEI e famílias em todo o estado do RJ. Especialista em reduzir mensalidades a cada 2 anos sem perder qualidade de cobertura.
                  </p>
                  <a
                    href={SITE_CONFIG.whatsappLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 mt-3 text-sm font-semibold text-accent hover:underline"
                  >
                    Falar com o corretor →
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <aside class="space-y-8 lg:sticky lg:top-28 lg:self-start order-3 lg:order-2">
            <div class="rounded-xl bg-secondary p-8 text-white">
              <h3 class="font-display mb-3 text-lg font-semibold">Precisa de ajuda?</h3>
              <p class="mb-6 text-sm text-stone-300">
                Tire dúvidas ou solicite uma cotação comparativa gratuita com um corretor credenciado ANS.
              </p>
              <a
                href={SITE_CONFIG.whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 active:scale-95"
              >
                Falar no WhatsApp
              </a>
            </div>

            {relatedPosts.length > 0 && (
              <div class="rounded-xl border border-stone-200 bg-white p-8 shadow-elegant">
                <h4 class="font-display mb-4 text-sm font-semibold uppercase tracking-wider text-charcoal">
                  Leia também
                </h4>
                <ul class="space-y-4">
                  {relatedPosts.map((p) => (
                    <li>
                      <a
                        href={`/blog/${p.slug}`}
                        class="text-sm font-medium text-stone-600 transition-colors hover:text-accent leading-relaxed block"
                      >
                        {p.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        </div>
      </div>
    </div>
  </section>
</Layout>
