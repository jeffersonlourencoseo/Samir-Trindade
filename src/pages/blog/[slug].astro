---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../../data/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const relatedPosts = (await getCollection('blog'))
  .filter((p) => p.slug !== post.slug && p.data.tags.some((t) => post.data.tags.includes(t)))
  .slice(0, 3);

const formattedDate = post.data.publishDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={post.data.title} description={post.data.description} type="article">
  <style>
    .prose-article :global(h1) {
      display: none;
    }
    .prose-article :global(h2) {
      font-size: 1.75rem;
      font-weight: 800;
      color: #111827;
      margin-top: 3rem;
      margin-bottom: 1.25rem;
      line-height: 1.2;
      letter-spacing: -0.025em;
    }
    .prose-article :global(h3) {
      font-size: 1.375rem;
      font-weight: 700;
      color: #1f2937;
      margin-top: 2rem;
      margin-bottom: 1rem;
      line-height: 1.3;
    }
    .prose-article :global(p) {
      margin-bottom: 1.25rem;
      line-height: 1.75;
      color: #374151;
    }
    .prose-article :global(ul), .prose-article :global(ol) {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
    }
    .prose-article :global(li) {
      margin-bottom: 0.5rem;
      line-height: 1.7;
    }
    .prose-article :global(a[href*="wa.me"]) {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background-color: #1E3A8A;
      color: #ffffff !important;
      font-weight: 700;
      font-size: 0.9375rem;
      padding: 0.75rem 1.5rem;
      border-radius: 9999px;
      text-decoration: none;
      transition: all 0.3s ease;
      box-shadow: 0 4px 14px rgba(30, 58, 138, 0.25);
      margin: 1rem 0;
    }
    .prose-article :global(a[href*="wa.me"]:hover) {
      background-color: #FACC15;
      color: #000000 !important;
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(250, 204, 21, 0.3);
    }
    .prose-article :global(hr) {
      border: 0;
      height: 1px;
      background: #e5e7eb;
      margin: 2.5rem 0;
    }
    .prose-article :global(strong) {
      color: #111827;
      font-weight: 700;
    }
    .prose-article :global(blockquote) {
      border-left: 4px solid #FACC15;
      padding-left: 1.25rem;
      margin: 1.5rem 0;
      font-style: italic;
      color: #4b5563;
    }
    .prose-article :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
    }
    .prose-article :global(th), .prose-article :global(td) {
      border: 1px solid #e5e7eb;
      padding: 0.75rem 1rem;
      text-align: left;
    }
    .prose-article :global(th) {
      background: #f9fafb;
      font-weight: 700;
      color: #111827;
    }
    .prose-article :global(tr:nth-child(even)) {
      background: #f9fafb;
    }
  </style>

  <section class="bg-accent py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-4xl">
        <div class="flex flex-wrap gap-2 mb-6">
          {post.data.tags.map((tag) => (
            <span class="rounded-full bg-primary/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="text-3xl font-black leading-tight tracking-tighter text-white md:text-5xl lg:text-6xl mb-6">
          {post.data.title}
        </h1>
        <p class="text-gray-400 text-sm">
          Publicado em <time datetime={post.data.publishDate.toISOString()}>{formattedDate}</time>
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-16 lg:grid-cols-[1fr_340px]">
          <article class="prose-article">
            <Content />

            <div class="mt-16 pt-10 border-t border-gray-200">
              <div class="rounded-2xl bg-secondary p-10 text-white text-center">
                <h2 class="text-2xl font-black mb-4 !text-white !mt-0">Pronto para encontrar seu plano ideal?</h2>
                <p class="text-gray-200 mb-8 max-w-lg mx-auto">
                  Receba uma cotação comparativa personalizada em até 24 horas. Compare operadoras e escolha com segurança.
                </p>
                <a
                  href={SITE_CONFIG.whatsappLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 text-base font-bold text-accent shadow-lg shadow-primary/20 transition-all duration-300 hover:scale-105 hover:shadow-xl active:scale-95"
                >
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                  </svg>
                  Falar no WhatsApp
                </a>
              </div>
            </div>
          </article>

          <aside class="space-y-8 lg:sticky lg:top-28 lg:self-start">
            <div class="rounded-2xl bg-gray-50 p-8 border border-gray-100">
              <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-gray-900">
                Neste artigo
              </h3>
              <nav class="space-y-3 text-sm">
                <a href="#" class="block text-gray-600 hover:text-secondary transition-colors">Introdução</a>
                <a href="#" class="block text-gray-600 hover:text-secondary transition-colors">Principais tópicos</a>
                <a href="#" class="block text-gray-600 hover:text-secondary transition-colors">Perguntas frequentes</a>
                <a href="#" class="block text-gray-600 hover:text-secondary transition-colors">Conclusão</a>
              </nav>
            </div>

            <div class="rounded-2xl bg-secondary p-8 text-white">
              <h3 class="mb-3 text-lg font-bold">Precisa de ajuda?</h3>
              <p class="mb-6 text-sm text-gray-200">
                Tire dúvidas ou solicite uma cotação comparativa gratuita com um corretor credenciado ANS.
              </p>
              <a
                href={SITE_CONFIG.whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-bold text-accent shadow-lg transition-all duration-300 hover:scale-105 active:scale-95"
              >
                Falar no WhatsApp
              </a>
            </div>

            {relatedPosts.length > 0 && (
              <div class="rounded-2xl border border-gray-100 bg-gray-50 p-8">
                <h4 class="mb-4 text-sm font-bold uppercase tracking-wider text-gray-900">
                  Leia também
                </h4>
                <ul class="space-y-4">
                  {relatedPosts.map((p) => (
                    <li>
                      <a
                        href={`/blog/${p.slug}`}
                        class="text-sm font-medium text-gray-700 transition-colors hover:text-secondary leading-relaxed block"
                      >
                        {p.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        </div>
      </div>
    </div>
  </section>
</Layout>
