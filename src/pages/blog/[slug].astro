---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { SITE_CONFIG } from '../../data/config';
import { absUrl } from '../../data/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, seoTitle, description, publishDate, updatedDate, image, imageAlt, imageCredit, tags, faq } = post.data;
const modified = updatedDate ?? publishDate;

const toc = headings.filter((h) => h.depth === 2);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.data.tags.some((t) => tags.includes(t)))
  .slice(0, 3);

const servicosAll = await getCollection('servicos');
const servicosRel = post.data.servicos
  .map((s) => servicosAll.find((x) => x.slug === s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });

let coverUrl = absUrl(SITE_CONFIG.ogImage);
if (image) {
  const opt = await getImage({ src: image, format: 'webp' });
  coverUrl = absUrl(opt.src);
}

const crumbs = [
  { name: 'Início', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: title },
];
const breadcrumbItems = [{ name: 'Blog', url: '/blog/' }, { name: title }];
---

<Layout
  title={seoTitle ?? title}
  description={description}
  type="article"
  pageType="article"
  crumbs={crumbs}
  faq={faq}
  datePublished={publishDate.toISOString()}
  dateModified={modified.toISOString()}
  article={{
    headline: title,
    description,
    image: coverUrl,
    datePublished: publishDate.toISOString(),
    dateModified: modified.toISOString(),
  }}
>
  <!-- HERO -->
  <section class="bg-secondary py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-4xl">
        <Breadcrumbs items={breadcrumbItems} />
        <div class="mb-6 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full border border-gold/30 bg-gold/10 px-4 py-1.5 text-sm font-semibold text-gold">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="font-display mb-6 text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl lg:text-6xl" style="text-wrap: balance">
          {title}
        </h1>
        <p class="text-sm text-stone-300">
          Publicado em <time datetime={publishDate.toISOString()}>{fmt(publishDate)}</time>
          <span class="mx-2">·</span>
          Atualizado em <time datetime={modified.toISOString()}>{fmt(modified)}</time>
          <span class="mx-2">·</span>
          Por {SITE_CONFIG.author}
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cream py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-16 lg:grid-cols-[1fr_340px]">
          <div class="order-1 min-w-0">
            {image && (
              <figure class="mb-10">
                <Image
                  src={image}
                  alt={imageAlt ?? title}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1024px) 700px, 100vw"
                  format="webp"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="h-auto w-full rounded-xl"
                />
                {imageCredit && <figcaption class="mt-2 text-sm text-stone-600">Foto: {imageCredit}</figcaption>}
              </figure>
            )}

            {toc.length > 0 && (
              <div class="mb-10 rounded-xl border border-stone-200 bg-white p-6 shadow-elegant">
                <p class="font-display mb-4 text-base font-semibold text-charcoal">Neste artigo</p>
                <nav aria-label="Neste artigo" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                  {toc.map((h) => (
                    <a href={`#${h.slug}`} class="py-1 text-stone-600 transition-colors hover:text-accent">{h.text}</a>
                  ))}
                </nav>
              </div>
            )}

            <div class="mb-10 rounded-xl bg-accent/5 p-6">
              <p class="leading-relaxed text-stone-700">
                <strong class="text-charcoal">Resumo:</strong> {description}
              </p>
              <a
                href={SITE_CONFIG.whatsappLink}
                data-evento="clique_whatsapp"
                data-local="post-texto"
                target="_blank"
                rel="noopener"
                class="mt-4 inline-flex min-h-[48px] items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:scale-105 active:scale-95 motion-reduce:transform-none"
              >
                <WhatsAppIcon class="h-4 w-4" />
                Pedir cotação pelo WhatsApp
              </a>
            </div>

            <article class="prose-article">
              <Content />
            </article>

            {servicosRel.length > 0 && (
              <div class="mt-16 rounded-xl border border-stone-200 bg-white p-8 shadow-elegant">
                <h2 class="font-display mb-4 text-xl font-semibold text-charcoal">Páginas relacionadas</h2>
                <ul class="space-y-3">
                  {servicosRel.map((s) => (
                    <li>
                      <a href={`/servicos/${s.slug}/`} class="inline-block py-1 text-lg font-medium text-secondary underline decoration-stone-300 underline-offset-4 transition-colors hover:text-accent">
                        {s.data.title}
                      </a>
                      <p class="text-sm text-stone-600">{s.data.description}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Autor -->
            <div class="mt-10 rounded-xl border border-stone-200 bg-white p-8 shadow-elegant">
              <div class="flex items-start gap-5">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-secondary font-display text-lg font-semibold text-white" aria-hidden="true">S</div>
                <div>
                  <p class="font-display text-lg font-semibold text-charcoal">{SITE_CONFIG.author}</p>
                  <p class="mt-1 text-sm text-stone-600">{SITE_CONFIG.authorBio}</p>
                  <a href="/sobre/" class="mt-3 inline-flex min-h-[48px] items-center text-sm font-semibold text-secondary hover:underline">
                    Conheça o corretor →
                  </a>
                </div>
              </div>
            </div>

            {relatedPosts.length > 0 && (
              <div class="mt-16">
                <h2 class="font-display mb-6 text-2xl font-semibold text-charcoal">Artigos relacionados</h2>
                <ul class="space-y-3">
                  {relatedPosts.map((p) => (
                    <li>
                      <a href={`/blog/${p.slug}/`} class="inline-block py-1 text-lg font-medium text-secondary underline decoration-stone-300 underline-offset-4 transition-colors hover:text-accent">
                        {p.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- Sidebar -->
          <aside class="order-2 space-y-8 lg:sticky lg:top-28 lg:self-start">
            <div class="rounded-xl bg-secondary p-8 text-white">
              <p class="font-display mb-3 text-lg font-semibold">Precisa de ajuda para escolher?</p>
              <p class="mb-6 text-sm text-stone-300">
                Tire dúvidas ou peça uma cotação comparativa gratuita com um corretor credenciado ANS.
              </p>
              <a
                href={SITE_CONFIG.whatsappLink}
                data-evento="clique_whatsapp"
                data-local="post-lateral"
                target="_blank"
                rel="noopener"
                class="inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 active:scale-95 motion-reduce:transform-none"
              >
                <WhatsAppIcon class="h-4 w-4" />
                Falar no WhatsApp
              </a>
            </div>

            {servicosRel.length > 0 && (
              <div class="rounded-xl border border-stone-200 bg-white p-8 shadow-elegant">
                <p class="font-display mb-4 text-base font-semibold text-charcoal">Planos citados</p>
                <ul class="space-y-3">
                  {servicosRel.map((s) => (
                    <li>
                      <a href={`/servicos/${s.slug}/`} class="block py-1 text-sm font-medium leading-relaxed text-stone-700 transition-colors hover:text-accent">
                        {s.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        </div>
      </div>
    </div>
  </section>
</Layout>
