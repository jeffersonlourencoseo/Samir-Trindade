---
import Layout from '../../layouts/Layout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaBreadcrumb from '../../components/SchemaBreadcrumb.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../../data/config';

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((s) => ({
    params: { slug: s.slug },
    props: { servico: s },
  }));
}

const { servico } = Astro.props;
const { Content } = await servico.render();

const canonicalUrl = new URL(Astro.url.pathname, SITE_CONFIG.domain).toString();

const breadcrumbItems = [
  { name: 'Planos', url: '/servicos' },
  { name: servico.data.title },
];
---

<Layout title={servico.data.title} description={servico.data.description}>
  <SchemaService
    name={`Plano de Saúde ${servico.data.operadora}`}
    description={servico.data.description}
    url={canonicalUrl}
  />
  <SchemaBreadcrumb items={[{ name: 'Início', url: '/' }, { name: 'Planos', url: '/servicos' }, { name: servico.data.title }]} />

  <!-- HERO -->
  <section class="bg-secondary py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl">
        <Breadcrumbs items={breadcrumbItems} />
        <span class="mb-4 inline-block rounded-lg bg-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent border border-accent/20"
        >
          {servico.data.operadora}
        </span>
        <h1 class="font-display text-4xl font-semibold leading-tight tracking-tight text-white md:text-6xl mb-6">
          {servico.data.title}
        </h1>
        <p class="text-lg text-stone-300">{servico.data.description}</p>
      </div>
    </div>
  </section>

  <!-- CORRETOR -->
  <section class="py-16 md:py-20 bg-white border-b border-stone-100">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-accent/10 text-2xl font-semibold text-secondary border border-accent/20"
        >
          ST
        </div>
        <div>
          <p class="text-base text-stone-600 leading-relaxed">
            <strong class="text-charcoal">{SITE_CONFIG.author}</strong> é corretor de planos de saúde credenciado ANS <strong class="text-charcoal">{SITE_CONFIG.ansRegister}</strong> no Rio de Janeiro.
            Atende empresas, MEI e famílias com foco em reduzir a mensalidade a cada 2 anos sem perder qualidade.
          </p>
          <a
            href={SITE_CONFIG.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary hover:underline"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Fale com o corretor
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTEÚDO -->
  <section class="py-24 md:py-32 bg-cream">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl">
        <!-- Resumo para AI -->
        <div class="rounded-xl border-l-4 border-accent bg-accent/5 p-6 mb-10">
          <p class="text-stone-700 leading-relaxed">
            <strong class="text-charcoal">Resumo:</strong> {servico.data.description} Corretor credenciado ANS no Rio de Janeiro com +10 operadoras. Cotação gratuita e personalizada em até 24h.
          </p>
        </div>

        <article class="prose-article max-w-none">
          <Content />
        </article>

        <!-- Author Bio -->
        <div class="mt-16 rounded-xl border border-stone-200 bg-white p-8 shadow-elegant">
          <div class="flex items-start gap-5">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-secondary font-display text-lg font-semibold text-white">S</div>
            <div>
              <p class="font-display text-lg font-semibold text-charcoal">{SITE_CONFIG.author}</p>
              <p class="text-sm text-stone-500 mt-1">
                Corretor credenciado ANS <strong class="text-charcoal">{SITE_CONFIG.ansRegister}</strong>, especialista em planos {servico.data.operadora} para empresas, MEI e famílias no Rio de Janeiro. Atendimento presencial no Centro do Rio e online por WhatsApp para todo o estado.
              </p>
              <a
                href={SITE_CONFIG.whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 mt-3 text-sm font-semibold text-accent hover:underline"
              >
                Falar com o corretor →
              </a>
            </div>
          </div>
        </div>

        <div class="mt-10 rounded-xl bg-white p-10 border border-stone-200 shadow-elegant">
          <h3 class="font-display mb-4 text-xl font-semibold text-charcoal">Quer uma cotação deste plano?</h3>
          <p class="mb-6 text-stone-600">
            Receba uma proposta personalizada em até 24h. Comparo condições entre operadoras para
            você escolher com segurança.
          </p>
          <a
            href={SITE_CONFIG.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-8 py-4 text-base font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 active:scale-95"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Solicitar cotação no WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
