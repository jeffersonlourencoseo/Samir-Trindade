---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../../data/config';

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((s) => ({
    params: { slug: s.slug },
    props: { servico: s },
  }));
}

const { servico } = Astro.props;
const { Content } = await servico.render();
const { title, seoTitle, description, etiqueta, faq, posts, publishDate, updatedDate, operadora } = servico.data;

const faqItems = faq ?? [];
const allPosts = await getCollection('blog');
const relatedPosts = posts
  .map((slug) => allPosts.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const outrosServicos = (await getCollection('servicos'))
  .filter((s) => s.slug !== servico.slug)
  .slice(0, 6);

const breadcrumbItems = [{ name: 'Planos', url: '/servicos/' }, { name: title }];
const crumbs = [{ name: 'Início', url: '/' }, { name: 'Planos de saúde', url: '/servicos/' }, { name: title }];
const serviceName =
  operadora && !/^Várias/.test(operadora) ? `Plano de Saúde ${operadora}` : title;
---

<Layout
  title={seoTitle ?? title}
  description={description}
  pageType="service"
  crumbs={crumbs}
  faq={faqItems}
  service={{ name: serviceName, description }}
  datePublished={publishDate.toISOString()}
  dateModified={(updatedDate ?? publishDate).toISOString()}
>
  <!-- HERO -->
  <section class="bg-secondary py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl">
        <Breadcrumbs items={breadcrumbItems} />
        {etiqueta && (
          <p class="mb-4 inline-block rounded-lg border border-gold/30 bg-gold/10 px-3 py-1 text-sm font-semibold text-gold">
            {etiqueta}
          </p>
        )}
        <h1 class="font-display mb-6 text-4xl font-semibold leading-tight tracking-tight text-white md:text-6xl" style="text-wrap: balance">
          {title}
        </h1>
        <p class="text-lg text-stone-300">{description}</p>
        <div class="mt-10">
          <a
            href={SITE_CONFIG.whatsappLink}
            data-evento="clique_whatsapp"
            data-local="servico"
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-accent px-8 py-4 text-base font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 active:scale-95 motion-reduce:transform-none motion-reduce:transition-none"
          >
            <WhatsAppIcon class="h-5 w-5" />
            Solicitar cotação no WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CORRETOR -->
  <section class="border-b border-stone-100 bg-white py-16 md:py-20">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center sm:flex-row sm:text-left">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border border-accent/20 bg-accent/10 text-2xl font-semibold text-secondary" aria-hidden="true">
          ST
        </div>
        <div>
          <p class="text-base leading-relaxed text-stone-600">
            <strong class="text-charcoal">{SITE_CONFIG.author}</strong> é corretor de planos de saúde credenciado ANS
            <strong class="text-charcoal">{SITE_CONFIG.ansRegister}</strong>, com escritório no Centro do Rio de Janeiro. Atende empresas, MEI e famílias, e a cotação não tem custo extra.
          </p>
          <a
            href={SITE_CONFIG.whatsappLink}
            data-evento="clique_whatsapp"
            data-local="servico"
            target="_blank"
            rel="noopener"
            class="mt-3 inline-flex min-h-[48px] items-center gap-1.5 text-sm font-semibold text-secondary hover:underline"
          >
            <WhatsAppIcon class="h-4 w-4" />
            Fale com o corretor
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTEÚDO -->
  <section class="bg-cream py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl">
        <article class="prose-article max-w-none">
          <Content />
        </article>

        <p class="mt-10 text-sm text-stone-600">
          Atualizado em <time datetime={(updatedDate ?? publishDate).toISOString()}>{(updatedDate ?? publishDate).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}</time>.
        </p>

        {relatedPosts.length > 0 && (
          <div class="mt-16">
            <h2 class="font-display mb-6 text-2xl font-semibold text-charcoal">Leia também</h2>
            <ul class="space-y-3">
              {relatedPosts.map((p) => (
                <li>
                  <a href={`/blog/${p.slug}/`} class="inline-block py-1 text-lg font-medium text-secondary underline decoration-stone-300 underline-offset-4 transition-colors hover:text-accent">
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {faqItems.length > 0 && (
          <div class="mt-16">
            <h2 class="font-display mb-6 text-2xl font-semibold text-charcoal">Perguntas frequentes</h2>
            <div class="space-y-4">
              {faqItems.map((item) => (
                <details class="group rounded-xl border border-stone-200 bg-white p-6 shadow-elegant">
                  <summary class="cursor-pointer list-none font-display text-lg font-semibold text-charcoal marker:content-none">
                    {item.question}
                  </summary>
                  <p class="mt-3 leading-relaxed text-stone-600" set:html={item.answer.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-secondary underline">$1</a>')} />
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- Autor -->
        <div class="mt-16 rounded-xl border border-stone-200 bg-white p-8 shadow-elegant">
          <div class="flex items-start gap-5">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-secondary font-display text-lg font-semibold text-white" aria-hidden="true">S</div>
            <div>
              <p class="font-display text-lg font-semibold text-charcoal">{SITE_CONFIG.author}</p>
              <p class="mt-1 text-sm text-stone-600">{SITE_CONFIG.authorBio}</p>
            </div>
          </div>
        </div>

        <div class="mt-10 rounded-xl border border-stone-200 bg-white p-10 shadow-elegant">
          <h2 class="font-display mb-4 text-xl font-semibold text-charcoal">Quer uma cotação deste plano?</h2>
          <p class="mb-6 text-stone-600">
            Eu comparo as condições entre operadoras para você escolher com segurança, sem custo extra pela cotação.
          </p>
          <div class="flex flex-col gap-4 sm:flex-row">
            <a
              href={SITE_CONFIG.whatsappLink}
              data-evento="clique_whatsapp"
              data-local="servico"
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-accent px-8 py-4 text-base font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 active:scale-95 motion-reduce:transform-none motion-reduce:transition-none"
            >
              <WhatsAppIcon class="h-5 w-5" />
              Solicitar cotação no WhatsApp
            </a>
            <a
              href={SITE_CONFIG.telefoneLink}
              data-evento="clique_telefone"
              data-local="servico"
              class="inline-flex min-h-[48px] items-center justify-center rounded-full border-2 border-secondary px-8 py-4 text-base font-semibold text-secondary transition-all duration-300 hover:scale-105 active:scale-95 motion-reduce:transform-none motion-reduce:transition-none"
            >
              Ligar {SITE_CONFIG.phone}
            </a>
          </div>
        </div>

        <div class="mt-16">
          <h2 class="font-display mb-6 text-2xl font-semibold text-charcoal">Outras operadoras que eu comparo</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {outrosServicos.map((s) => (
              <li>
                <a href={`/servicos/${s.slug}/`} class="block rounded-lg border border-stone-200 bg-white px-5 py-3 font-medium text-secondary transition-colors hover:border-accent hover:text-accent">
                  {s.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
