---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../../data/config';

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((s) => ({
    params: { slug: s.slug },
    props: { servico: s },
  }));
}

const { servico } = Astro.props;
const { Content } = await servico.render();
---

<Layout title={servico.data.title} description={servico.data.description}>
  <!-- HERO SERVIÇO -->
  <section class="bg-accent py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl">
        <span class="mb-4 inline-block rounded-lg bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary"
        >
          {servico.data.operadora}
        </span>
        <h1 class="text-4xl font-black leading-tight tracking-tighter text-white md:text-6xl mb-6">
          {servico.data.title}
        </h1>
        <p class="text-lg text-gray-300">{servico.data.description}</p>
      </div>
    </div>
  </section>

  <!-- CONTEÚDO -->
  <section class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl">
        <article class="prose prose-lg max-w-none">
          <Content />
        </article>

        <div class="mt-16 rounded-2xl bg-gray-50 p-10 border border-gray-100">
          <h3 class="mb-4 text-xl font-bold text-gray-900">Quer uma cotação deste plano?</h3>
          <p class="mb-6 text-gray-600">
            Receba uma proposta personalizada em até 24h. Comparo condições entre operadoras para
            você escolher com segurança.
          </p>
          <a
            href={SITE_CONFIG.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 text-base font-bold text-accent shadow-lg shadow-primary/20 transition-all duration-300 hover:scale-105 active:scale-95"
          >
            Solicitar cotação no WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
