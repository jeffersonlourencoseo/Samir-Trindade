---
import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { SITE_CONFIG } from '../data/config';

const links = [
  { href: '/servicos/', label: 'Planos de saúde por operadora' },
  { href: '/servicos/plano-empresarial-de-saude/', label: 'Plano empresarial de saúde' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contato/', label: 'Contato' },
];
---

<Layout title="Página não encontrada" description="A página que você procurou não existe ou mudou de endereço. Volte para a página inicial ou fale com o corretor Samir Trindade pelo WhatsApp." noindex={true}>
  <section class="bg-secondary py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-display mb-4 text-xl font-semibold text-gold">Erro 404</p>
        <h1 class="mb-6 text-4xl font-extrabold leading-tight tracking-tighter text-white md:text-6xl" style="text-wrap: balance">
          Não encontramos essa página
        </h1>
        <p class="mx-auto max-w-xl text-lg text-stone-300">
          O endereço pode ter mudado ou ter sido digitado errado. Use um dos caminhos abaixo ou fale direto com o corretor.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/" class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-accent px-8 py-4 text-base font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 active:scale-95 motion-reduce:transform-none">
            Voltar para o início
          </a>
          <a
            href={SITE_CONFIG.whatsappLink}
            data-evento="clique_whatsapp"
            data-local="cta-final"
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full border border-white/30 px-8 py-4 text-base font-semibold text-white transition-all duration-300 hover:scale-105 active:scale-95 motion-reduce:transform-none"
          >
            <WhatsAppIcon class="h-5 w-5" />
            Falar no WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-white py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-2xl">
        <h2 class="font-display mb-6 text-2xl font-semibold text-gray-900">Páginas mais acessadas</h2>
        <ul class="space-y-2">
          {links.map((l) => (
            <li>
              <a href={l.href} class="inline-block py-2 text-lg font-medium text-secondary underline decoration-stone-300 underline-offset-4 hover:text-accent">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Layout>
