---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../data/config';
import { Image } from 'astro:assets';
import { AVALIACOES_GOOGLE } from '../data/avaliacoes';

const servicos = await getCollection('servicos');
const destaques = ['plano-de-saude-para-idosos', 'plano-de-saude-mei', 'plano-empresarial-de-saude', 'plano-de-saude-individual-e-familiar', 'unimed-rj', 'valor-plano-de-saude-bradesco', 'amil', 'sulamerica', 'hapvida'];
const servicosDestaque = destaques
  .map((slug) => servicos.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const diferenciais = [
  {
    icon: '🔍',
    title: 'Comparo operadoras',
    desc: 'Mostro propostas lado a lado, com rede, carência e regra de reajuste, para você escolher com informação.',
  },
  {
    icon: '🏥',
    title: 'Operadoras do Rio',
    desc: 'Amil, Bradesco, SulAmérica, Unimed, Hapvida, NotreDame, Porto Seguro, Assim, Leve, MedSênior e Prevent Senior.',
  },
  {
    icon: '🏢',
    title: 'Individual, MEI e empresas',
    desc: 'Planos individuais, familiares, para MEI, empresariais e para a terceira idade, na capital e na Baixada.',
  },
  {
    icon: '📍',
    title: 'Presencial e online',
    desc: 'Escritório no Centro do Rio (Av. Rio Branco, 108) e atendimento por WhatsApp para todo o estado.',
  },
];

const criterios = [
  { t: 'Idade de cada pessoa', d: 'O valor muda por faixa etária, e a tabela só faz sentido com as idades de quem vai usar.' },
  { t: 'Modalidade', d: 'Individual, familiar, por adesão, MEI ou empresarial: cada uma tem regra de contratação e de reajuste.' },
  { t: 'Hospitais e médicos', d: 'Liste onde você quer ser atendido. Rede longe de casa vira gasto particular.' },
  { t: 'Acomodação', d: 'Enfermaria ou apartamento muda o preço e o conforto na internação.' },
  { t: 'Coparticipação', d: 'Mensalidade menor com pagamento por uso, ou mensalidade maior e previsível.' },
  { t: 'Abrangência', d: 'Município, região do Rio ou nacional. Quem não viaja pode escolher abrangência menor.' },
  { t: 'Carência', d: 'Peça por escrito o prazo de cada tipo de atendimento antes de assinar.' },
  { t: 'Orçamento', d: 'Compare o conjunto, não só a menor mensalidade: rede, carência e reajuste entram na conta.' },
];

const modalidades = [
  { t: 'Individual e familiar', d: 'Contrato por CPF, para uma pessoa ou para a família.', href: '/servicos/plano-de-saude-individual-e-familiar/' },
  { t: 'Plano para MEI', d: 'Contrato pelo CNPJ do microempreendedor, com as regras de cada operadora.', href: '/servicos/plano-de-saude-mei/' },
  { t: 'Plano empresarial', d: 'Para empresas, com contrato coletivo e condições próprias.', href: '/servicos/plano-empresarial-de-saude/' },
  { t: 'Plano para idosos', d: 'Operadoras com foco no público sênior e de rede ampla.', href: '/servicos/plano-de-saude-para-idosos/' },
];

const passos = [
  { t: 'Conversa pelo WhatsApp', d: 'Você informa quem vai usar o plano, as idades, o bairro e os hospitais de preferência.' },
  { t: 'Propostas comparadas', d: 'Envio propostas de mais de uma operadora, com rede, carência e regras explicadas.' },
  { t: 'Contratação', d: 'Ajudo com documentos e com a assinatura, sem custo extra para você.' },
  { t: 'Acompanhamento', d: 'Depois da contratação, tiro dúvidas de uso, reembolso e reajuste.' },
];

const faqHome = [
  {
    question: 'Qual é o plano de saúde bom e barato no RJ?',
    answer: 'Depende do seu uso. Operadoras regionais costumam ter menor preço de entrada, mas o que vale é comparar rede, coparticipação, carência e regra de reajuste, não só a mensalidade. Eu faço a cotação com o seu perfil em mais de uma operadora.',
  },
  {
    question: 'Qual o melhor plano de saúde do Rio de Janeiro?',
    answer: 'Não existe um melhor plano para todos. O melhor é o que tem a rede perto de você, a carência e o reajuste que fazem sentido e um preço que cabe no orçamento. Veja o guia para escolher o melhor plano de saúde no Rio e peça uma cotação comparada.',
  },
  {
    question: 'Quais planos de saúde estão disponíveis no Rio de Janeiro?',
    answer: 'Trabalho com Amil, Bradesco Saúde, SulAmérica, Unimed, Porto Seguro Saúde, NotreDame Intermédica, Hapvida, Assim Saúde, Leve Saúde, MedSênior e Prevent Senior. A disponibilidade muda por produto, idade e região, e eu confirmo na cotação.',
  },
  {
    question: 'O corretor cobra pela cotação?',
    answer: 'Não. A cotação e a contratação pelo corretor não têm custo extra para você.',
  },
  {
    question: 'Posso contratar direto na operadora?',
    answer: 'Em muitos casos sim. A vantagem do corretor é comparar várias operadoras de uma vez, explicar as regras e acompanhar você depois da contratação, sem custo extra.',
  },
  {
    question: 'Você atende fora da capital?',
    answer: 'Atendo no município do Rio de Janeiro e na Baixada, como Duque de Caxias, Nova Iguaçu, São João de Meriti, Belford Roxo, Nilópolis e Mesquita. Por WhatsApp, o atendimento alcança todo o estado.',
  },
];

---

<Layout rawTitle="Plano de Saúde no Rio de Janeiro | Samir Trindade" description="Plano de saúde no Rio de Janeiro: compare operadoras, entenda carência e rede e peça cotação grátis com o corretor Samir Trindade, credenciado ANS." pageType="home" faq={faqHome}>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-secondary py-28 md:py-40">
    <div class="absolute inset-0 opacity-[0.03]">
      <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <div class="container relative mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-4xl text-center">
        <span class="mb-8 inline-block rounded-full border border-accent/40 bg-accent/10 px-5 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-gold"
        >
          Corretor Credenciado ANS {SITE_CONFIG.ansRegister}
        </span>

        <h1 class="font-display text-4xl font-semibold leading-[1.1] tracking-tight text-white md:text-6xl lg:text-7xl">
          Plano de saúde no Rio de Janeiro: compare operadoras e peça cotação com um corretor
        </h1>

        <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-stone-300 md:text-xl">
          Comparo as operadoras que atendem o Rio de Janeiro e a Baixada e explico rede, carência e reajuste antes de você contratar.
          Atendimento no Centro do Rio e por WhatsApp, com cotação gratuita.
        </p>

        <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={SITE_CONFIG.whatsappLink} data-evento="clique_whatsapp" data-local="hero"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-8 py-4 text-base font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 hover:shadow-xl active:scale-95"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Falar com o corretor
          </a>

          <a
            href="/servicos/"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-8 py-4 text-base font-semibold text-white backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-white/10 active:scale-95"
          >
            Conhecer Planos
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFERENCIAIS -->
  <section class="py-24 md:py-32 bg-cream">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mb-16 text-center">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
          Por que fazer a cotação comigo
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-stone-600">
          Corretor credenciado na ANS, com atendimento direto, sem call center.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {diferenciais.map((item) => (
          <div class="group rounded-xl border border-stone-200 bg-white p-8 transition-all duration-300 hover:border-accent/20 hover:shadow-elegant">
            <div class="mb-4 text-2xl" aria-hidden="true">{item.icon}</div>
            <h3 class="font-display mb-3 text-lg font-semibold text-charcoal">{item.title}</h3>
            <p class="text-sm leading-relaxed text-stone-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO ESCOLHER -->
  <section class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mb-16 text-center">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
          Como escolher o plano de saúde certo no Rio
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-stone-600">
          Oito pontos decidem se o plano serve para você. Eu levo todos para a cotação e comparo as operadoras pelos mesmos critérios. Se quiser aprofundar, leia o guia do <a href="/blog/melhor-plano-de-saude/" class="text-secondary underline">melhor plano de saúde no Rio</a>.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {criterios.map((c) => (
          <div class="rounded-xl border border-stone-200 bg-cream p-8">
            <h3 class="font-display mb-3 text-lg font-semibold text-charcoal">{c.t}</h3>
            <p class="text-sm leading-relaxed text-stone-600">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SOBRE RESUMO -->
  <section class="py-24 md:py-32 bg-sage">
    <div class="container mx-auto px-6 md:px-12">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="space-y-6">
          <span class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Sobre</span>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
            Quem é o Samir Trindade, corretor de plano de saúde no Rio
          </h2>
          <p class="text-lg leading-relaxed text-stone-600">
            Sou Samir Trindade, corretor de plano de saúde credenciado na ANS, no Rio de Janeiro.
            Atendo famílias, MEI e empresas. Meu foco é simples:
            <strong class="text-charcoal">explicar cada ponto do plano antes de você assinar e continuar por perto depois.</strong>
          </p>
          <p class="text-lg leading-relaxed text-stone-600">
            Como corretor, eu comparo operadoras, tiro dúvidas sobre carência, rede e reajuste e acompanho o contrato
            depois da contratação. A cotação é gratuita e não tem custo extra para você.
          </p>
          <a
            href="/sobre/"
            class="inline-flex items-center gap-2 rounded-full bg-secondary px-8 py-4 text-base font-semibold text-white shadow-elevated transition-all duration-300 hover:scale-105 hover:shadow-xl active:scale-95"
          >
            Conheça minha história
          </a>
        </div>

        <div class="rounded-xl bg-white p-10 shadow-elegant border border-stone-100">
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/10 text-xl" aria-hidden="true">📍</div>
              <div>
                <p class="font-semibold text-charcoal">Localização</p>
                <p class="text-sm text-stone-600">Av. Rio Branco, 108, 21º andar — Centro, Rio de Janeiro/RJ</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/10 text-xl" aria-hidden="true">📞</div>
              <div>
                <p class="font-semibold text-charcoal">Contato</p>
                <p class="text-sm text-stone-600">{SITE_CONFIG.phone} — WhatsApp e ligação</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/10 text-xl" aria-hidden="true">🕐</div>
              <div>
                <p class="font-semibold text-charcoal">Horário</p>
                <p class="text-sm text-stone-600">Seg–Sex 8h–19h | Sáb 8h–15h</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/10 text-xl" aria-hidden="true">🏅</div>
              <div>
                <p class="font-semibold text-charcoal">Credenciamento</p>
                <p class="text-sm text-stone-600">Registro ANS {SITE_CONFIG.ansRegister}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OPERADORAS -->
  <section class="py-24 md:py-32 bg-cream">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mb-16 text-center">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Operadoras</span>
        <h2 class="font-display mt-3 text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
          Operadoras que eu atendo no Rio de Janeiro
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-stone-600">
          Veja a página de cada operadora com rede, carência e regras. Eu comparo as que atendem o seu perfil.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {servicosDestaque.map((s) => (
          <a
            href={`/servicos/${s.slug}/`}
            class="group flex flex-col items-center rounded-xl border border-stone-200 bg-white p-10 transition-all duration-300 hover:border-accent/20 hover:shadow-elegant text-center"
          >
            <div class="mb-4 inline-block rounded-md bg-sage px-4 py-2 text-sm font-semibold uppercase tracking-wider text-secondary border border-stone-100">
              {s.data.operadora}
            </div>
            <h3 class="font-display mb-3 text-xl font-semibold text-charcoal group-hover:text-secondary transition-colors">
              {s.data.title}
            </h3>
            <p class="mb-6 text-sm leading-relaxed text-stone-600">{s.data.description}</p>
            <span class="mt-auto inline-flex items-center gap-1 rounded-full bg-accent px-6 py-2 text-sm font-semibold text-white transition-all group-hover:translate-x-1"
            >
              Saiba mais →
            </span>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href={SITE_CONFIG.whatsappLink} data-evento="clique_whatsapp" data-local="cta-meio"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-8 py-4 text-base font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 active:scale-95"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          Fale com o corretor
        </a>
      </div>
    </div>
  </section>

  <!-- TIPOS DE CONTRATAÇÃO -->
  <section class="py-24 md:py-32 bg-sage">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mb-16 text-center">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
          Tipos de contratação
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-stone-600">
          O tipo de contrato muda regra, reajuste e carência. Escolha a página que combina com o seu caso.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {modalidades.map((m) => (
          <a href={m.href} class="group flex flex-col rounded-xl border border-stone-200 bg-white p-8 transition-all duration-300 hover:border-accent/20 hover:shadow-elegant">
            <h3 class="font-display mb-3 text-lg font-semibold text-charcoal group-hover:text-secondary transition-colors">{m.t}</h3>
            <p class="mb-6 text-sm leading-relaxed text-stone-600">{m.d}</p>
            <span class="mt-auto text-sm font-semibold text-secondary">Ver detalhes →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- REDE E HOSPITAIS -->
  <section class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
          Rede credenciada e hospitais por região
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-stone-600">
          A rede muda de uma operadora para outra e de um produto para outro. No Rio, vale olhar a região em que você vive e trabalha: Zona Sul, Zona Norte, Zona Oeste, Barra da Tijuca, Centro e Baixada.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-stone-600">
          Antes de fechar, eu confiro na proposta se os hospitais, laboratórios e médicos que você quer manter estão na rede do produto escolhido, porque listas antigas enganam. Para casos específicos, como idosos ou empresas, veja as páginas de <a href="/servicos/plano-de-saude-para-idosos/" class="text-secondary underline">plano para idosos</a> e de <a href="/servicos/plano-empresarial-de-saude/" class="text-secondary underline">plano empresarial</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="py-24 md:py-32 bg-cream">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mb-16 text-center">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
          Como funciona a contratação comigo
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {passos.map((p, i) => (
          <div class="rounded-xl border border-stone-200 bg-white p-8">
            <p class="font-display mb-3 text-3xl font-semibold text-accent" aria-hidden="true">{i + 1}</p>
            <h3 class="font-display mb-3 text-lg font-semibold text-charcoal">{p.t}</h3>
            <p class="text-sm leading-relaxed text-stone-600">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AVALIAÇÕES REAIS DO GOOGLE (sem schema Review) -->
  {AVALIACOES_GOOGLE.itens.length > 0 && (
    <section class="py-24 md:py-32 bg-white">
      <div class="container mx-auto px-6 md:px-12">
        <div class="mb-16 text-center">
          <h2 class="font-display text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
            O que dizem os clientes
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-stone-600">
            Nota {AVALIACOES_GOOGLE.nota} com {AVALIACOES_GOOGLE.total} avaliações no Google.
          </p>
        </div>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {AVALIACOES_GOOGLE.itens.map((a) => (
            <figure class="flex flex-col rounded-xl border border-stone-200 bg-cream p-8">
              <p class="mb-4 text-lg tracking-widest text-accent" role="img" aria-label="5 estrelas de 5">★★★★★</p>
              <blockquote class="mb-6 flex-1 leading-relaxed text-stone-700">“{a.texto}”</blockquote>
              <figcaption class="text-sm text-stone-600">
                <span class="font-semibold text-charcoal">{a.nome}</span><br />
                {AVALIACOES_GOOGLE.fonte}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display mb-10 text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
          Perguntas frequentes
        </h2>
        <div class="space-y-4">
          {faqHome.map((item) => (
            <details class="group rounded-xl border border-stone-200 bg-cream p-6">
              <summary class="cursor-pointer list-none font-display text-lg font-semibold text-charcoal marker:content-none">
                {item.question}
              </summary>
              <p class="mt-3 leading-relaxed text-stone-600">{item.answer}</p>
            </details>
          ))}
        </div>
        <div class="mt-12 rounded-xl border border-stone-200 bg-sage p-8">
          <h2 class="font-display mb-3 text-2xl font-semibold text-charcoal">Onde eu atendo</h2>
          <p class="leading-relaxed text-stone-600">
            No município do Rio de Janeiro, com escritório no Centro, e na Baixada: Duque de Caxias, Nova Iguaçu, São João de Meriti, Belford Roxo, Nilópolis e Mesquita. Por WhatsApp, o atendimento alcança todo o estado.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="py-24 md:py-32 bg-sage">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <span class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Blog</span>
          <h2 class="font-display mt-3 text-3xl font-semibold tracking-tight text-charcoal md:text-5xl">
            Dicas e novidades
          </h2>
        </div>
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 rounded-full border border-stone-300 bg-white px-6 py-3 text-sm font-semibold text-charcoal transition-all duration-300 hover:border-accent hover:bg-accent/5 hover:text-accent"
        >
          Ver todos os posts
        </a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {blogPosts.map((post) => (
          <a
            href={`/blog/${post.slug}/`}
            class="group flex flex-col rounded-xl border border-stone-200 bg-white transition-all duration-300 hover:border-accent/20 hover:shadow-elegant overflow-hidden"
          >
            {post.data.image ? (
              <div class="relative h-48 w-full overflow-hidden bg-stone-200">
                <Image
                  src={post.data.image}
                  alt={post.data.imageAlt ?? post.data.title}
                  width={800}
                  height={400}
                  widths={[400, 800]}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent" />
                <div class="absolute bottom-4 left-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-secondary shadow-sm">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ) : (
              <div class="bg-sage p-8 border-b border-stone-100">
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-secondary">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            )}
            <div class="flex flex-1 flex-col p-8">
              <h3 class="font-display mb-3 text-lg font-semibold text-charcoal group-hover:text-secondary transition-colors">
                {post.data.title}
              </h3>
              <p class="mb-6 text-sm leading-relaxed text-stone-600">{post.data.description}</p>
              <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-secondary transition-all group-hover:translate-x-1"
              >
                Ler artigo →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-24 md:py-32 bg-secondary relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]">
      <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid2" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid2)" />
      </svg>
    </div>
    <div class="container relative mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
          Pronto para encontrar o melhor plano?
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-stone-300">
          Peça uma cotação comparativa pelo WhatsApp. Sem compromisso e sem custo extra.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={SITE_CONFIG.whatsappLink} data-evento="clique_whatsapp" data-local="cta-final"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-8 py-4 text-base font-semibold text-white shadow-gold transition-all duration-300 hover:scale-105 hover:shadow-xl active:scale-95"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Falar com o corretor
          </a>

          <a
            href={SITE_CONFIG.telefoneLink} data-evento="clique_telefone" data-local="cta-final"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-8 py-4 text-base font-semibold text-white backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-white/10 active:scale-95"
          >
            Ligar Agora
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
