---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<Layout title="Blog">
  <section class="bg-accent py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl text-center">
        <span class="mb-4 inline-block text-sm font-bold uppercase tracking-widest text-primary">Blog</span>
        <h1 class="text-4xl font-black leading-tight tracking-tighter text-white md:text-6xl mb-10">
          Dicas e novidades sobre plano de saúde
        </h1>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col rounded-2xl border border-gray-100 bg-gray-50 transition-all duration-300 hover:scale-[1.02] hover:border-primary/20 hover:shadow-xl overflow-hidden"
          >
            {post.data.image ? (
              <div class="relative h-48 w-full overflow-hidden bg-gray-200">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  width="800"
                  height="400"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent" />
                <div class="absolute bottom-4 left-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-bold uppercase tracking-wider text-secondary shadow-sm">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ) : (
              <div class="bg-secondary/10 p-6">
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full bg-white/80 px-3 py-1 text-xs font-bold uppercase tracking-wider text-secondary">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            )}
            <div class="flex flex-1 flex-col p-10">
              <p class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-400">
                {post.data.publishDate.toLocaleDateString('pt-BR', {
                  day: '2-digit',
                  month: 'long',
                  year: 'numeric',
                })}
              </p>
              <h2 class="mb-3 text-lg font-bold text-gray-900 group-hover:text-secondary transition-colors">
                {post.data.title}
              </h2>
              <p class="mb-6 text-sm leading-relaxed text-gray-600">{post.data.description}</p>
              <span class="mt-auto inline-flex items-center gap-1 text-sm font-bold text-secondary transition-all group-hover:translate-x-1"
              >
                Ler artigo →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
