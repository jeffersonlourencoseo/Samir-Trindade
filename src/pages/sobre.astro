---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/config';

const valores = [
  {
    title: 'Transparência',
    desc: 'Mostro o custo-benefício real de cada operadora, sem esconder taxas ou carências.',
  },
  {
    title: 'Acompanhamento',
    desc: 'Não vendo e sumo. Reviso seu plano anualmente e troco operadora quando for vantajoso.',
  },
  {
    title: 'Especialização',
    desc: 'Foco total em planos de saúde. Não divido atenção com seguros de vida, carro ou casa.',
  },
  {
    title: 'Resultado',
    desc: 'Meta: reduzir sua mensalidade a cada 2 anos sem perder qualidade de cobertura.',
  },
];
---

<Layout title="Sobre">
  <!-- HERO -->
  <section class="bg-accent py-24 md:py-32">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl text-center">
        <span class="mb-4 inline-block text-sm font-bold uppercase tracking-widest text-primary">Sobre</span>
        <h1 class="text-4xl font-black leading-tight tracking-tighter text-white md:text-6xl mb-10">
          Quem é Samir Trindade
        </h1>
      </div>
    </div>
  </section>

  <!-- MINHA HISTÓRIA -->
  <section class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="space-y-6">
          <span class="text-sm font-bold uppercase tracking-widest text-secondary">Minha História</span>
          <h2 class="text-3xl font-black tracking-tighter text-gray-900 md:text-5xl">
            Corretor de plano de saúde que não some depois da venda
          </h2>
          <p class="text-lg leading-relaxed text-gray-600">
            Meu nome é <strong class="text-gray-900">Samir Trindade</strong>. Sou nascido na década de 80, esposo e pai de quatro filhos. Moro no Rio de Janeiro e trabalho com planos de saúde há anos, atendendo empresas, MEIs e famílias em todo o estado.
          </p>
          <p class="text-lg leading-relaxed text-gray-600">
            Entrei no mercado de saúde suplementar vendo de perto o que mais frustrava os clientes: corretores que desapareciam depois da assinatura. Promessas de suporte que viravam caixa postal. Decidi que não seria mais um na estatística.
          </p>
          <p class="text-lg leading-relaxed text-gray-600">
            Hoje, meu trabalho é simples: encontrar o melhor plano para o seu perfil e acompanhar você ao longo do tempo. Reviso seu contrato a cada 2 anos, negocio reajustes abusivos e, quando necessário, migro para outra operadora sem carência — sempre reduzindo a parcela e mantendo a qualidade.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a
              href={SITE_CONFIG.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-8 py-4 text-base font-bold text-accent shadow-lg shadow-primary/20 transition-all duration-300 hover:scale-105 active:scale-95"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              Falar com o corretor
            </a>
            <a
              href={`tel:${SITE_CONFIG.phoneRaw}`}
              class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-secondary px-8 py-4 text-base font-bold text-secondary transition-all duration-300 hover:scale-105 hover:bg-secondary hover:text-white active:scale-95"
            >
              Ligar agora
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-8">
          <div class="rounded-2xl bg-gray-100 overflow-hidden aspect-[4/5] max-w-md mx-auto lg:mx-0 w-full">
            <img
              src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=600&h=750&fit=crop&crop=face"
              alt="Samir Trindade — Corretor de Planos de Saúde no Rio de Janeiro"
              class="h-full w-full object-cover"
              loading="eager"
            />
          </div>

          <div class="rounded-2xl bg-gray-50 p-12 border border-gray-100">
            <div class="space-y-8">
              <div>
                <p class="text-5xl font-black text-primary">+10</p>
                <p class="mt-1 text-gray-600">Operadoras credenciadas</p>
              </div>
              <div class="h-px bg-gray-200"></div>
              <div>
                <p class="text-5xl font-black text-primary">2.998</p>
                <p class="mt-1 text-gray-600">Vidas atendidas (de 3 a 3000)</p>
              </div>
              <div class="h-px bg-gray-200"></div>
              <div>
                <p class="text-5xl font-black text-primary">2 em 2</p>
                <p class="mt-1 text-gray-600">Anos: revisão proativa de contrato</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSÃO VISÃO VALORES -->
  <section class="py-24 md:py-32 bg-gray-50">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mb-16 text-center">
        <span class="text-sm font-bold uppercase tracking-widest text-secondary">Compromisso</span>
        <h2 class="mt-2 text-3xl font-black tracking-tighter text-gray-900 md:text-5xl">
          Missão, Visão e Valores
        </h2>
      </div>

      <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
        {valores.map((v) => (
          <div class="rounded-2xl border border-gray-100 bg-white p-10 transition-all duration-300 hover:shadow-xl">
            <h3 class="mb-3 text-lg font-bold text-gray-900">{v.title}</h3>
            <p class="text-sm leading-relaxed text-gray-600">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPROMISSO -->
  <section class="py-24 md:py-32 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="order-2 lg:order-1 rounded-2xl bg-secondary p-12 text-white">
          <h3 class="mb-6 text-2xl font-black">O que o pós-venda inclui</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="mt-1 text-primary">✓</span>
              <span>Revisão anual de mensalidade e reajustes</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-primary">✓</span>
              <span>Negociação de reajustes abusivos com a operadora</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-primary">✓</span>
              <span>Troca de operadora sem carência (portabilidade)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-primary">✓</span>
              <span>Resolução de problemas de autorização e sinistros</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-primary">✓</span>
              <span>Inclusão e exclusão de beneficiários</span>
            </li>
          </ul>
        </div>

        <div class="order-1 lg:order-2 space-y-6">
          <span class="text-sm font-bold uppercase tracking-widest text-secondary">Padrão de Atendimento</span>
          <h2 class="text-3xl font-black tracking-tighter text-gray-900 md:text-5xl">
            O melhor pós-venda do mercado
          </h2>
          <p class="text-lg leading-relaxed text-gray-600">
            Toda empresa precisa trocar o plano de saúde de 2 em 2 anos para uma redução na parcela
            sem perder qualidade. Eu faço essa revisão de forma proativa — não espero você ligar
            reclamando do reajuste.
          </p>
          <p class="text-lg leading-relaxed text-gray-600">
            Acompanho os clientes e atendo suas necessidades. Se uma operadora mudar a rede credenciada
            ou piorar o atendimento, eu já estou preparando alternativas.
          </p>
          <a
            href={SITE_CONFIG.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 text-base font-bold text-accent shadow-lg shadow-primary/20 transition-all duration-300 hover:scale-105 active:scale-95"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Fale com o corretor
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ATENDIMENTO -->
  <section class="py-24 md:py-32 bg-gray-50">
    <div class="container mx-auto px-6 md:px-12">
      <div class="mx-auto max-w-3xl text-center">
        <span class="text-sm font-bold uppercase tracking-widest text-secondary">Atendimento</span>
        <h2 class="mt-2 text-3xl font-black tracking-tighter text-gray-900 md:text-5xl mb-10">
          Atendimento humanizado
        </h2>
        <p class="text-lg leading-relaxed text-gray-600 mb-10">
          Cada cliente tem um perfil único. Uma empresa de 10 vidas precisa de uma solução diferente
          de uma empresa de 500. Uma família com crianças pequenas precisa de cobertura pediátrica.
          Uma empresa com colaboradores acima de 50 anos precisa de rede geriátrica.
        </p>
        <p class="text-lg leading-relaxed text-gray-600">
          Meu atendimento é presencial no Centro do Rio de Janeiro (Av. Rio Branco, 108, 21º andar)
          e online por WhatsApp e videochamada para todo o estado do RJ.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={SITE_CONFIG.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 text-base font-bold text-accent shadow-lg shadow-primary/20 transition-all duration-300 hover:scale-105 active:scale-95"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 5.834h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Agendar uma conversa
          </a>
          <a
            href={`tel:${SITE_CONFIG.phoneRaw}`}
            class="inline-flex items-center gap-2 rounded-full border-2 border-secondary px-8 py-4 text-base font-bold text-secondary transition-all duration-300 hover:scale-105 hover:bg-secondary hover:text-white active:scale-95"
          >
            Ligar agora
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
